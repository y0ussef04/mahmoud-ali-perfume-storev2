# ملفات مش محتاجينها جوه صورة Docker — بتخلّي البناء أسرع وأنضف

# اعتماديات هتتثبّت جوه الصورة من جديد
node_modules
npm-debug.log*

# ناتج بناء محلّي — الصورة بتبني بنفسها
.next
out
build

# أسرار — ممنوع تدخل الصورة إطلاقاً
.env
.env.*
!.env.example

# جيت وأدوات التطوير
.git
.gitignore
.vercel
.vscode
.idea

# ملفات نظام
.DS_Store
Thumbs.db

# توثيق ومخرجات مش لازمة للتشغيل
*.md
!README.md
